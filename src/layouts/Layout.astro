---
import Header from '../components/Header';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AnalytXpert - Profit Intelligence for Shopify',
  description = 'I help Shopify brands turn confusing analytics into clear, profitable decisions.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-28BWE2TQHM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-28BWE2TQHM');
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <Header client:load />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
