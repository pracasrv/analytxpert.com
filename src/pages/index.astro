---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AnalytXpert - Data-Driven Insights. Real Profit Growth.">
  <!-- Hero Section -->
  <div class="relative overflow-hidden bg-gradient-to-b from-background via-background to-secondary/20">
    <div class="max-w-6xl mx-auto px-6 py-24 sm:py-32">
      <div class="text-center mb-16">
        <h1 class="text-5xl sm:text-6xl md:text-7xl font-bold mb-6 leading-tight">
          Data-Driven Insights.<br />Real Profit Growth.
        </h1>
        <p class="text-xl sm:text-2xl text-muted-foreground max-w-3xl mx-auto mb-8">
          I help Shopify brands turn confusing analytics into clear, profitable decisions.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://calendly.com/pracasrv/15min"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center h-14 px-8 text-lg font-medium bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors"
          >
            Book a Free Call
            <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
          <a
            href="/profit-intelligence"
            class="inline-flex items-center justify-center h-14 px-8 text-lg font-medium border border-input bg-background rounded-md hover:bg-accent hover:text-accent-foreground transition-colors"
          >
            Learn More
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Services Overview -->
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">What I Offer</h2>
      <p class="text-lg text-muted-foreground">Specialized analytics services for growing e-commerce brands</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 mb-16">
      <div class="p-8 bg-card rounded-xl border border-border hover:border-primary/50 transition-colors">
        <div class="h-12 w-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
          <svg class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
        </div>
        <h3 class="text-xl font-bold mb-3">Profit Intelligence</h3>
        <p class="text-muted-foreground mb-4">Monthly analysis of your real profitability across channels, products, and campaigns.</p>
        <a href="/profit-intelligence" class="text-primary font-semibold hover:underline">Learn more &rarr;</a>
      </div>

      <div class="p-8 bg-card rounded-xl border border-border opacity-60">
        <div class="h-12 w-12 bg-secondary rounded-lg flex items-center justify-center mb-4">
          <svg class="h-6 w-6 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
        </div>
        <h3 class="text-xl font-bold mb-3">Custom Analytics</h3>
        <p class="text-muted-foreground mb-4">Coming soon: Tailored analytics solutions for your specific business needs.</p>
      </div>

      <div class="p-8 bg-card rounded-xl border border-border opacity-60">
        <div class="h-12 w-12 bg-secondary rounded-lg flex items-center justify-center mb-4">
          <svg class="h-6 w-6 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5" /></svg>
        </div>
        <h3 class="text-xl font-bold mb-3">Performance Audits</h3>
        <p class="text-muted-foreground mb-4">Coming soon: Deep-dive audits to identify growth opportunities and profit leaks.</p>
      </div>
    </div>
  </div>

  <!-- Growth Bottleneck Finder CTA -->
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="bg-gradient-to-br from-primary/10 via-primary/5 to-background border-2 border-primary/20 rounded-2xl p-8 md:p-12">
      <div class="flex flex-col md:flex-row items-center gap-8">
        <div class="flex-shrink-0">
          <div class="h-20 w-20 bg-primary/20 rounded-full flex items-center justify-center">
            <svg class="h-10 w-10 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          </div>
        </div>
        <div class="flex-1 text-center md:text-left">
          <h2 class="text-3xl md:text-4xl font-bold mb-3">Find Your Hidden Growth Bottleneck</h2>
          <p class="text-lg text-muted-foreground mb-6">Take our free 5-minute diagnostic to discover the one constraint most likely limiting your growth.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
            <a href="/resources/growth-bottleneck-finder" class="inline-flex items-center justify-center h-14 px-8 text-lg font-medium bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors">
              Start Free Diagnostic
              <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
            <div class="flex items-center justify-center md:justify-start gap-6 text-sm text-muted-foreground">
              <span>&#10003; 7 questions</span>
              <span>&#10003; 5 minutes</span>
              <span>&#10003; Instant results</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- CTA Section -->
  <div class="bg-secondary/20">
    <div class="max-w-4xl mx-auto px-6 py-16 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">Ready to Unlock Hidden Profit?</h2>
      <p class="text-lg text-muted-foreground mb-8">Book a free 15-minute call to see how I can help your Shopify store grow profitably.</p>
      <a href="https://calendly.com/pracasrv/15min" target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center justify-center h-14 px-8 text-lg font-medium bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors">
        Book Your Free Call
      </a>
    </div>
  </div>
</Layout>
