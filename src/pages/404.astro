---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Page Not Found | AnalytXpert">
  <div class="flex flex-col items-center justify-center min-h-[60vh] px-6 text-center">
    <h1 class="text-6xl font-bold mb-4">404</h1>
    <p class="text-xl text-muted-foreground mb-8">Page not found.</p>
    <a href="/" class="inline-flex items-center justify-center h-10 px-4 text-sm font-medium bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors">
      Go Home
    </a>
  </div>
</Layout>
