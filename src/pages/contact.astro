---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
---

<Layout title="Contact - AnalytXpert">
  <div class="container max-w-4xl px-6 py-16">
    <div class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Get in Touch</h1>
      <p class="text-xl text-muted-foreground">Have questions about Profit Intelligence? Let's talk.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-12">
      <div>
        <ContactForm client:load />
      </div>

      <div class="space-y-8">
        <div>
          <h2 class="text-2xl font-bold mb-4">Prefer to book a call?</h2>
          <p class="text-muted-foreground mb-4">Schedule a 15-minute intro call to see if Profit Intelligence is right for your business.</p>
          <a href="https://calendly.com/pracasrv/15min" target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center justify-center h-11 px-8 text-sm font-medium border border-input bg-background rounded-md hover:bg-accent hover:text-accent-foreground transition-colors">
            Book a Call
          </a>
        </div>

        <div class="pt-8 border-t border-border">
          <h3 class="font-semibold mb-4">Who should reach out?</h3>
          <ul class="space-y-3 text-sm text-muted-foreground">
            <li class="flex items-start gap-2"><span class="text-primary mt-1">&#10003;</span><span>Shopify brands doing $250k-$2M/month</span></li>
            <li class="flex items-start gap-2"><span class="text-primary mt-1">&#10003;</span><span>Spending $100k+/month on paid ads</span></li>
            <li class="flex items-start gap-2"><span class="text-primary mt-1">&#10003;</span><span>Looking to understand true profitability</span></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</Layout>
